{
  "manifest_version": 3,
  "name": "Browser Control",
  "version": "0.5.1",
  "description": "Steuert den sichtbaren, eingeloggten Firefox über die Bridge auf dem Server.",
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_icon": "icons/bridge-off.svg",
    "default_title": "Browser Control — aus"
  },
  "permissions": ["tabs", "storage", "webRequest", "scripting"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["page-agent.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws: wss:"
  },
  "options_ui": {
    "page": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-control@bergkaese.dev"
    }
  }
}
