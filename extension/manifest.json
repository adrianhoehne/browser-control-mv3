{
  "manifest_version": 2,
  "name": "Browser Control",
  "version": "0.5.1",
  "description": "Steuert den sichtbaren, eingeloggten Firefox über die Bridge auf dem Server.",
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_icon": "icons/bridge-off.svg",
    "default_title": "Browser Control — aus"
  },
  "permissions": ["tabs", "storage", "<all_urls>", "webRequest"],
  "web_accessible_resources": ["page-agent.js"],
  "options_ui": {
    "page": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-control@bergkaese.dev"
    }
  }
}
