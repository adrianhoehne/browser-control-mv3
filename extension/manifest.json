{
  "manifest_version": 2,
  "name": "Browser Control",
  "version": "0.5.1",
  "description": "Steuert den sichtbaren, eingeloggten Firefox über die Bridge auf dem Server.",
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "permissions": ["tabs", "storage", "<all_urls>", "webRequest"],
  "options_ui": {
    "page": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-control@bergkaese.dev"
    }
  }
}
