# One `tools/call` per tool, with one argument its schema forbids (`bogus`). Every
# tool refuses it with its own sentence, before anything reaches the extension —
# which is why this file runs without a fixture: a call that arrived at a peer
# would prove the refusal happened too late.
{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"browser_status","arguments":{"bogus":1}}}
{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"browser_navigate","arguments":{"url":"https://example.org/","bogus":1}}}
{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"browser_read","arguments":{"bogus":1}}}
{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"browser_click","arguments":{"selector":"a#video-title-link","bogus":1}}}
{"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"browser_type","arguments":{"selector":"input#q","typed_text":"Zeile eins","submit":true,"bogus":1}}}
{"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"browser_focus","arguments":{"bogus":1}}}
{"jsonrpc":"2.0","id":7,"method":"tools/call","params":{"name":"browser_inspect","arguments":{"selector":"a#cart-link","bogus":1}}}
{"jsonrpc":"2.0","id":8,"method":"tools/call","params":{"name":"browser_open_tab","arguments":{"url":"https://example.org/","bogus":1}}}
{"jsonrpc":"2.0","id":9,"method":"tools/call","params":{"name":"browser_close_tab","arguments":{"bogus":1}}}
{"jsonrpc":"2.0","id":10,"method":"tools/call","params":{"name":"browser_eval","arguments":{"code":"return document.title","bogus":1}}}
{"jsonrpc":"2.0","id":11,"method":"tools/call","params":{"name":"browser_screenshot","arguments":{"bogus":1}}}
{"jsonrpc":"2.0","id":12,"method":"tools/call","params":{"name":"browser_frames","arguments":{"bogus":1}}}
{"jsonrpc":"2.0","id":13,"method":"tools/call","params":{"name":"browser_transcript","arguments":{"bogus":1}}}
