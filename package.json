{
  "name": "browser-control",
  "version": "0.8.0",
  "type": "module",
  "description": "Firefox extension plus bridge that exposes the operator's own browser to pi",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 --test-timeout=90000 test/*.test.js",
    "test:bundle": "node --test test/bundle/*.test.js",
    "test:ci": "node --test test/ci/*.test.js",
    "test:coverage": "node scripts/coverage.mjs",
    "test:coverage:rust": "node scripts/coverage-rust.mjs",
    "check": "node scripts/check.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrianhoehne/browser-control-mv3.git"
  },
  "bugs": {
    "url": "https://github.com/adrianhoehne/browser-control-mv3/issues"
  },
  "homepage": "https://github.com/adrianhoehne/browser-control-mv3#readme",
  "keywords": [
    "firefox",
    "extension",
    "mcp",
    "browser-automation",
    "pi"
  ]
}
